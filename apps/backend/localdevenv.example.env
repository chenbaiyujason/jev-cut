# Copy to apps/backend/localdevenv/.env. Never commit credentials.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Select model IDs available from your own provider; these are development defaults.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
MAD_EMBEDDING_ENABLED=true
# Leave empty to use the same venv as the media pipeline.
MAD_VISION_PYTHON=
MAD_ANALYSIS_WIDTH=640
MAD_ANALYSIS_FPS=12
MAD_ANALYSIS_CRF=30
MAD_ANALYSIS_AUDIO_KBPS=64
MAD_GEMINI_SAMPLE_FPS=4
MAD_GEMINI_CONCURRENCY=2
MAD_GEMINI_CHUNK_SECONDS=90
# A compatible decision server is independent from the editing application.
JEV_DECISION_URL=http://127.0.0.1:8091
JEV_DECISION_PATH=/v1/systemone
JEV_API_KEY=
# Leave empty for a server with one loaded model. Set only if it supports model routing.
JEV_MODEL=
JEV_SUPPORTS_IMAGES=true
JEV_IMAGE_POLICY=required
JEV_TIMEOUT_MS=30000
